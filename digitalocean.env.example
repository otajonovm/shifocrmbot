# === MAJBURIY ===
TELEGRAM_BOT_TOKEN=8593671786:AAHEqFDVZ...BotFather_token
SUPABASE_URL=https://qwngzvtanjlk....supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIs...service_role_key

# === WEBHOOK (DigitalOcean uchun MAJBURIY) ===
# PUBLIC_APP_URL — bot webhook URL uchun (VITE_ emas!)
PUBLIC_APP_URL=https://sea-lion-app-9vj5b.ondigitalocean.app
# yoki: PUBLIC_APP_URL=${APP_URL}
TELEGRAM_USE_WEBHOOK=true
TELEGRAM_POLLING_ENABLED=false
